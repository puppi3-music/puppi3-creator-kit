# The live module's passwords, plain (kit/setup.sh writes them, then puts them hashed in TinyIce's config.json,
# data/icecast/tinyice-data/config.json; changing one here later changes nothing until config.json is made again)

# Your DJ software's password (user "source", mount /stream-ogg)
TINYICE_SOURCE_PASSWORD=
# TinyIce's admin page (tinyice.<LAN_DOMAIN>, home network only); Prometheus signs in with it too
TINYICE_ADMIN_USER=admin
TINYICE_ADMIN_PASSWORD=
