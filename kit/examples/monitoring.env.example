# The monitoring module's secrets (kit/monitoring/compose.yaml; kit/setup.sh)

# Grafana's admin sign-in (user admin)
GRAFANA_ADMIN_PASSWORD=
# Grafana's read-only login to Ghost's MySQL and Postiz's Postgres (made at every start)
GRAFANA_RO_PASSWORD=
# Where the alerts go: NTFY_URL's topic (the bridge's notifications use the same one)
NTFY_TOPIC=
