#!/bin/sh
# The checks at each commit (turn them on once: git config core.hooksPath .githooks).

# 1. Guides: when a guide, the shared docs files or anything the Settings reference is made of is committed, copy the
#    shared files into every guide (docs/build-docs.py), so each guide stays a single file that works on its own, and
#    write the Settings reference again from its files (examples, compose files, setup.sh). Its checks stop the commit:
#    a setting read but not documented, documented but not read, or a private name in a guide.
if git diff --cached --name-only | grep -qE '^(docs/|kit/docs/|kit/examples/|kit/profiles/|kit/setup\.sh$|kit/compose\.yaml$|kit/monitoring/compose\.yaml$|instances/example\.env$|stacks/(traefik|puppi3|postiz|icecast)/(\.env\.example|compose\.yaml)$|stacks/traefik/dynamic/|k8s/examples/|k8s/overlays/[^/]+/cloud\.env\.example$)'; then
  python3 docs/build-docs.py || exit 1
  git add kit/docs/settings-reference.html kit/docs/setup-guide.html kit/docs/operations-guide.html \
    kit/docs/posting-guide.html kit/docs/analytics-guide.html kit/docs/theme-guide.html
fi

# 2. Grafana: grafana_ro may read only the tables listed in stacks/puppi3/grafana-ro.sh, so a dashboard or alert rule
#    reading another one stops the commit (stacks/monitoring/grafana/ro-tables.py says which). The dashboards also
#    keep one shared look (style.py: nav, crosshair, chart styles, colours; run it to fix). Both read the folder
#    dashboards through parts.py beside them, so a part that's broken or left over stops the commit too. The source
#    names no site (render.py's placeholders, @SITE_HOST@...): a render for the example profile must pass.
G=stacks/monitoring/grafana
if git diff --cached --name-only | grep -qE "^($G/provisioning/dashboards/|$G/alerts\.yml|$G/(parts|ro-tables)\.py|stacks/puppi3/grafana-ro\.sh)"; then
  python3 $G/ro-tables.py --check || exit 1
fi
if git diff --cached --name-only | grep -qE "^($G/provisioning/dashboards/|$G/alerts\.yml|$G/[^/]+\.py|instances/example\.env)"; then
  out=$(mktemp -d)
  python3 $G/render.py --profile kit --site instances/example.env $G/provisioning/dashboards/json "$out" \
    || { rm -rf "$out"; exit 1; }
  rm -rf "$out"
fi
if git diff --cached --name-only | grep -qE "^$G/(provisioning/dashboards/|style\.py|parts\.py)"; then
  python3 $G/style.py --check || exit 1
fi

# 3. The bridge (stacks/postiz/ghost-bridge/: .mjs files there and in share/, pages/, stats/; never data/): every
#    module loads (an import of a name another module doesn't export only shows when Node loads it), and
#    docs/bridge-map.md is current: every module has its heading, every file it names exists, every export it lists is
#    still exported (.githooks/bridge-check.mjs).
if git diff --cached --name-only | grep -qE '^(stacks/postiz/ghost-bridge/|docs/bridge-map\.md$)'; then
  if command -v node >/dev/null 2>&1; then
    # (no settings, so it starts nothing; it exits as soon as every module has loaded)
    err=$(cd stacks/postiz/ghost-bridge && env -i PATH="$PATH" PORT=0 DRY_RUN=true STATE_FILE=/nonexistent/posted.json \
      MAP="$OLDPWD/docs/bridge-map.md" node "$OLDPWD/.githooks/bridge-check.mjs" 2>&1 >/dev/null) \
      || { echo "$err" | grep '^pre-commit:' || echo "pre-commit: the bridge doesn't load"; exit 1; }
  fi
fi
exit 0
