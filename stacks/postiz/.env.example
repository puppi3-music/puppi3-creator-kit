# Variables for the postiz stack's .env, each explained here (the Settings reference shows the same text).
# Postiz's address (postiz.<the site>), and the secret it signs its sign-ins with
POSTIZ_DOMAIN=postiz.example.com
POSTIZ_JWT_SECRET=
# Postiz's database and Temporal's (its job runner); the bridge reads Postiz's too, for the networks' numbers
POSTIZ_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
# true = no one else can make a Postiz account (set it once yours is made)
POSTIZ_DISABLE_REGISTRATION=true

# Each network's developer app, which Postiz connects your accounts through (Instagram and Facebook: Meta's apps;
# YouTube: a Google app, which the bridge also uses for YouTube's numbers). Leave a network's empty to skip it.
THREADS_APP_ID=
THREADS_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ghost-bridge: Postiz's API key (Postiz -> Settings -> Developers, "Public API"), and the secret Ghost's webhook signs with
POSTIZ_API_KEY=
GHOST_WEBHOOK_SECRET=
# true = the bridge shares nothing: it logs what it would post, and draws a preview of each
GHOST_BRIDGE_DRY_RUN=false
# Social previews of drafts: Admin API key (<id>:<secret>) of a custom integration in Ghost Admin ->
# Settings -> Integrations (e.g. "Social preview"). Empty = the Social preview button shows "off".
GHOST_ADMIN_API_KEY=
# Phone notifications: the ntfy server (site.env's NTFY_URL), a topic only you know, and a token if the server
# asks for one
NTFY_URL=
NTFY_TOPIC=postiz
NTFY_TOKEN=
# Optional: seconds between a Story notification and the next [2]; days a photo page keeps working [14]
#NTFY_STORY_GAP=2
#PHOTO_PAGE_DAYS=14
# Optional: minutes between each network's checks (min 10) [60] (Cloudflare and Search Console have only daily
# numbers: faster gains nothing)
#IG_STATS_MINUTES=60
#YT_STATS_MINUTES=60
#SC_STATS_MINUTES=60
#BSKY_STATS_MINUTES=60
#THREADS_STATS_MINUTES=60
#TIKTOK_STATS_MINUTES=60
#MC_STATS_MINUTES=60
#GHOST_STATS_MINUTES=60
#CF_STATS_MINUTES=60
#GSC_STATS_MINUTES=60
# Each post's first hours kept check by check [96]; ntfy notice when an older post takes off [true], with a button
# to the Post dashboard at GRAFANA_URL (site.env's; empty = no button)
#POST_EARLY_HOURS=96
#TAKEOFF_NTFY=true
#GRAFANA_URL=
# Instagram/Threads: at most this many newest posts asked each check (+ as many older ones; a call each) [25], fewer
# when the calls would pass META_CALLS_PER_HOUR [120] (Meta allows about 200 an hour per account, Postiz included)
#IG_STATS_POSTS=25
#THREADS_STATS_POSTS=25
#META_CALLS_PER_HOUR=120
# Daily copies of the stats database (data/stats.db) kept in data/backups/ [7]; 0 = none
#STATS_DB_BACKUPS=7
# Days each network's followers etc. are kept at every check (the network files keep one per day for longer) [90]
#ACCOUNT_CHECK_DAYS=90
# SoundCloud numbers for Grafana: an app registered at soundcloud.com/you/apps (needs Artist Pro) and the
# profile to read (empty = the Social dashboard's SoundCloud status says what's missing)
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# the profile address, e.g. https://soundcloud.com/<name>
SOUNDCLOUD_USER=
# Bluesky account whose numbers Grafana shows (empty = the Bluesky channel's in Postiz)
BLUESKY_HANDLE=
# Seasonal profile pictures: the phone reminder lists these networks, in this order (the first two get an "Open"
# button); take one out to stop being reminded about it. PFP_SEASONS=false turns the reminders off.
#PFP_NETWORKS=bluesky,instagram,threads,tiktok,youtube,soundcloud,mixcloud,discord
#PFP_SEASONS=true
# Weekly summary on the phone: when it's sent ("<weekday> HH:MM", the site's time zone). WEEKLY_SUMMARY=false turns it off.
#WEEKLY_SUMMARY_AT=Mon 09:00
#WEEKLY_SUMMARY=true
# Mixcloud profile address, e.g. https://www.mixcloud.com/<name>/
MIXCLOUD_USER=
# Ghost's analytics (Tinybird) for the site's own posts on the Platforms dashboard: tinybird__adminToken from the
# tokens.env the analytics setup writes (a kit site's bridge reads that file itself, so leave this empty there; set it
# only for another token; none = posts, members and newsletter numbers only); the site_uuid only if Ghost doesn't give
# it (the one in the dashboards' Tinybird queries)
TINYBIRD_TOKEN=
TINYBIRD_SITE_UUID=
# Cloudflare: an API token with Zone > Analytics > Read for the site's zone, and the zone's ID (its Overview page)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Google Search Console: a service account's JSON key, base64'd onto one line (base64 -i key.json | tr -d '\n'),
# added as a user of the property; the property ("sc-domain:<the site>" for a domain property)
SEARCH_CONSOLE_KEY=
SEARCH_CONSOLE_SITE=sc-domain:example.com

# Site values from the instance profile (instances/CLAUDE.md); unset = as shown (SITE_NAME: SITE_HOST; SITE_HOSTS:
# SITE_HOST and www.; LIVE_HOSTS: LIVE_HOST)
#SITE_NAME=
#SITE_TIMEZONE=Etc/UTC
#ID_PREFIX=puppi3
#SITE_HOSTS=
#LIVE_HOSTS=
#PETS=true
# Live shows from TinyIce (kit/kit.sh sets false when the live module is off)
#LIVE_STATS=true
#NETWORKS=

# Site values, from the instance profile (instances/CLAUDE.md): the stacks folder's global.env where each stack
# runs on its own (every stack reads it), the kit's site.env. DATA_DIR and SITE_HOST must be set
#DATA_DIR=/srv/stacks
#SITE_HOST=example.com

# How posts are shared (CHANNELS, IG_TIKTOK_MODE, the tags, TIKTOK_METHOD... to TIKTOK_PRIVACY) are the site's
# settings (a kit site's site.env explains each); one set here too wins over it.
