    {
      "id": 8,
      "type": "table",
      "title": "Members who joined there, by network",
      "description": "New members who signed up on the page, by where they came from (our link tag first, else the referrer), grouped into networks as in \"Visitors by network\". In the dashboard's time range. Empty when no page is picked.",
      "datasource": {
        "type": "mysql",
        "uid": "ghost-mysql"
      },
      "gridPos": {
        "x": 18,
        "y": 15,
        "w": 6,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "ghost-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- the page (and the networks' source names) arrive URL-encoded in a double-quoted literal, the one form Grafana can't\n-- let a quote or backslash out of, and are decoded here\n-- (rules: the bridge's page.json `rules`, [{\"n\": network, \"r\": regex of Ghost's source names}], as Post's `sources`)\nWITH v AS (SELECT REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(\"${page:percentencode}\", '%2F', '/'), '%3F', '?'), '%3D', '='), '%26', '&'), '%23', '#'), '%2B', '+'), '%3A', ':'), '%2C', ','), '%3B', ';'), '%40', '@'), '%20', ' '), '%5E', '^'), '%7C', '|'), '%24', '$'), '%5B', '['), '%5D', ']'), '%28', '('), '%29', ')'), '%21', '!'), '%2A', '*'), '%25', '%') AS page,\n                   REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(\"${rules:percentencode}\", '%2F', '/'), '%3F', '?'), '%3D', '='), '%26', '&'), '%23', '#'), '%2B', '+'), '%3A', ':'), '%2C', ','), '%3B', ';'), '%40', '@'), '%20', ' '), '%5E', '^'), '%7C', '|'), '%24', '$'), '%5B', '['), '%5D', ']'), '%28', '('), '%29', ')'), '%21', '!'), '%2A', '*'), '%22', '\"'), '%7B', '{'), '%7D', '}'), '%25', '%') AS rules),\nsrc AS (SELECT COALESCE(NULLIF(m.utm_source, ''), IF(m.referrer_source IN ('', 'Direct'), '', m.referrer_source), '') AS source\n  FROM members_created_events m, v\n  WHERE (m.attribution_url = v.page\n    OR m.attribution_id IN (SELECT id FROM posts WHERE CONCAT('/', slug, '/') = v.page))\n    AND $__timeFilter(m.created_at))\n-- (in one collation, utf8mb4_bin: Ghost's tables, Grafana's connection and JSON_TABLE each have their own, which MySQL\n-- won't compare or mix)\nSELECT COALESCE(\n    (SELECT r.n FROM v, JSON_TABLE(IF(JSON_VALID(v.rules), v.rules, '[]'), '$[*]' COLUMNS (n VARCHAR(64) PATH '$.n', r VARCHAR(1000) PATH '$.r')) r\n     WHERE src.source <> '' AND REGEXP_LIKE(CONVERT(src.source USING utf8mb4) COLLATE utf8mb4_bin, CONVERT(r.r USING utf8mb4) COLLATE utf8mb4_bin) LIMIT 1),\n    CONVERT(NULLIF(src.source, '') USING utf8mb4) COLLATE utf8mb4_bin, 'Direct / unknown' COLLATE utf8mb4_bin) AS Network,\n  COUNT(*) AS Members\nFROM src\nGROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2013",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
