    {
      "id": 4,
      "type": "stat",
      "title": "New members who joined there",
      "description": "Members who signed up on the page (Ghost's attribution). In the dashboard's time range. Empty when no page is picked.",
      "datasource": {
        "type": "mysql",
        "uid": "ghost-mysql"
      },
      "gridPos": {
        "x": 18,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "ghost-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- the page (and the networks' source names) arrive URL-encoded in a double-quoted literal, the one form Grafana can't\n-- let a quote or backslash out of, and are decoded here\nWITH v AS (SELECT REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(\"${page:percentencode}\", '%2F', '/'), '%3F', '?'), '%3D', '='), '%26', '&'), '%23', '#'), '%2B', '+'), '%3A', ':'), '%2C', ','), '%3B', ';'), '%40', '@'), '%20', ' '), '%5E', '^'), '%7C', '|'), '%24', '$'), '%5B', '['), '%5D', ']'), '%28', '('), '%29', ')'), '%21', '!'), '%2A', '*'), '%25', '%') AS page)\nSELECT COUNT(*) AS Members\nFROM members_created_events m, v\nWHERE (m.attribution_url = v.page\n  OR m.attribution_id IN (SELECT id FROM posts WHERE CONCAT('/', slug, '/') = v.page))\n  AND $__timeFilter(m.created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.0.2",
      "links": [],
      "transformations": []
    },
    {
      "id": 5,
      "type": "table",
      "title": "Posts that led here",
      "description": "Every post that leads to the page, oldest first: \"Links here\" when the post links to it (the bridge's short links too), else the bridge's guess (the caption names the post, or it went up in the week after the page and before the next post), as on the Post dashboard. The main number is the one that network is mostly judged on; vs your usual is the post's verdict (hover for why). Click a row for that post up close. All time, not the time range. Several posts on one network can't be told apart in Ghost's numbers, so the visitors and members below are per network, not per post.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "bridge-instagram"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "bridge-instagram"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "http://postiz-ghost-bridge:8080/page.json",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "path",
                "value": "${page}"
              }
            ]
          },
          "root_selector": "$append([], posts)",
          "filters": [],
          "columns": [
            {
              "selector": "time",
              "text": "Posted",
              "type": "timestamp_epoch"
            },
            {
              "selector": "network",
              "text": "Network",
              "type": "string"
            },
            {
              "selector": "title",
              "text": "Post",
              "type": "string"
            },
            {
              "selector": "type",
              "text": "Kind",
              "type": "string"
            },
            {
              "selector": "how",
              "text": "How it leads here",
              "type": "string"
            },
            {
              "selector": "main",
              "text": "Main number",
              "type": "number"
            },
            {
              "selector": "mainLabel",
              "text": "Counted",
              "type": "string"
            },
            {
              "selector": "verdict",
              "text": "vs your usual",
              "type": "string"
            },
            {
              "selector": "why",
              "text": "perf_tip",
              "type": "string"
            },
            {
              "selector": "key",
              "text": "key",
              "type": "string"
            },
            {
              "selector": "ref",
              "text": "ref",
              "type": "string"
            },
            {
              "selector": "posted_ms",
              "text": "posted_ms",
              "type": "string"
            },
            {
              "selector": "permalink",
              "text": "permalink",
              "type": "string"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2013",
          "custom": {
            "minWidth": 70
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "links": [
            {
              "title": "This post up close: its numbers per day and what it did for the site",
              "url": "/d/puppi3-post?var-network=${__data.fields.key}&var-post=${__data.fields.ref}&from=${__data.fields.posted_ms}&to=now"
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "vs your usual"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^Doing great.*",
                      "result": {
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^Above usual.*",
                      "result": {
                        "color": "light-green",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^Below usual.*",
                      "result": {
                        "color": "light-orange",
                        "index": 2
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^Well below usual.*",
                      "result": {
                        "color": "orange",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "transparent"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
