        {
          "expr": "probe_success{instance=\"https://@SITE_HOST@\"}",
          "legendFormat": "",
          "interval": "",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
