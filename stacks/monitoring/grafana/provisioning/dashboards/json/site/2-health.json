    {
      "id": 115,
      "type": "stat",
      "title": "Errors (5xx, last hour)",
      "description": "Share of requests to @SITE_HOST@'s own routes that ended in a 5xx error over the last hour (Traefik). Blank = no requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(increase(traefik_router_requests_total{router=~\"puppi3-[a-z-]+@file|live-status@docker|puppi3-social-preview@docker\",code=~\"5..\"}[1h])) or vector(0)) / sum(increase(traefik_router_requests_total{router=~\"puppi3-[a-z-]+@file|live-status@docker|puppi3-social-preview@docker\"}[1h]))",
          "legendFormat": "",
          "interval": "",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
