    {
      "id": 112,
      "type": "stat",
      "title": "On air",
      "description": "Whether @DJ_SOFTWARE@ is sending audio to /stream-ogg right now (the mount the site's LIVE NOW bar watches). Not TinyIce's source count: its always-on /stream-mp3 transcode counts as a source too.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 6,
        "w": 4,
        "h": 4
      },
      "targets": [
