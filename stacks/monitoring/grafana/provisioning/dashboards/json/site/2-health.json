    {
      "id": 118,
      "type": "timeseries",
      "title": "Live stream: listeners' pauses and reconnects",
      "description": "Each time a LIVE NOW bar listener's player paused to buffer (\"Pause\") or dropped its connection and reconnected (\"Reconnect\"), counted by the theme and the bridge. Pause buffering = the browser ran out of audio; trickle = Firefox playing in bits. Reconnect dropped = the connection ended or failed; stuck = no audio for 15 s; slowstart = the first load took too long; behind = too far behind live after a stall. Many listeners at the same moment = the stream itself (see \"Coming in from @DJ_SOFTWARE@\"); one now and then = that listener's connection or device (the table beside says which).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (why) (puppi3_live_stalls_total{job=\"puppi3-pets\"}) - (sum by (why) (puppi3_live_stalls_total{job=\"puppi3-pets\"} offset $__interval) or sum by (why) (puppi3_live_stalls_total{job=\"puppi3-pets\"}) * 0)",
          "legendFormat": "Pause: {{why}}",
          "interval": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (why) (puppi3_live_reconnects_total{job=\"puppi3-pets\"}) - (sum by (why) (puppi3_live_reconnects_total{job=\"puppi3-pets\"} offset $__interval) or sum by (why) (puppi3_live_reconnects_total{job=\"puppi3-pets\"}) * 0)",
          "legendFormat": "Reconnect: {{why}}",
          "interval": "",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "13.0.2",
      "links": [],
      "transformations": [],
      "interval": "1m"
    },
    {
      "id": 121,
      "type": "table",
      "title": "Pauses and reconnects, by listener",
      "description": "In the selected range, by whether the page was in view, phone/tablet or computer, and browser. \"Background tab / locked phone\": there the player can't pause itself to build up a cushion, so a small dip is heard more easily.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 32,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "expr": "(sum by (tab, device, browser) (puppi3_live_stalls_total{job=\"puppi3-pets\"}) - (sum by (tab, device, browser) (puppi3_live_stalls_total{job=\"puppi3-pets\"} offset $__range) or sum by (tab, device, browser) (puppi3_live_stalls_total{job=\"puppi3-pets\"}) * 0)) > 0",
          "legendFormat": "",
          "interval": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "(sum by (tab, device, browser) (puppi3_live_reconnects_total{job=\"puppi3-pets\"}) - (sum by (tab, device, browser) (puppi3_live_reconnects_total{job=\"puppi3-pets\"} offset $__range) or sum by (tab, device, browser) (puppi3_live_reconnects_total{job=\"puppi3-pets\"}) * 0)) > 0",
          "legendFormat": "",
          "interval": "",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "noValue": "None in this range",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "hidden": {
                  "text": "Background tab / locked phone",
                  "index": 0
                },
                "shown": {
                  "text": "Page in view",
                  "index": 1
                },
                "mobile": {
                  "text": "Phone / tablet",
                  "index": 2
                },
                "computer": {
                  "text": "Computer",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Pauses",
            "desc": true
          }
        ]
      },
      "pluginVersion": "13.0.2",
      "links": [],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "device": 0,
              "browser": 1,
              "tab": 2,
              "Value #A": 3,
              "Value #B": 4
            },
            "renameByName": {
              "device": "Device",
              "browser": "Browser",
              "tab": "Page",
              "Value #A": "Pauses",
              "Value #B": "Reconnects"
            }
          }
        }
      ]
    },
    {
