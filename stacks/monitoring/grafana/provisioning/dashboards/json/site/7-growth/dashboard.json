    "variables": [],
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      },
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "mysql",
            "version": "v0",
            "datasource": {
              "name": "ghost-mysql"
            },
            "spec": {
              "datasource": {
                "type": "mysql",
                "uid": "ghost-mysql"
              },
              "editorMode": "code",
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT published_at AS time,\n       CONCAT('Published: ', title, '<br><a href=\"/d/puppi3-post?var-network=ghost&var-post=', id,\n              '&from=', CAST(UNIX_TIMESTAMP(published_at) * 1000 AS UNSIGNED), '&to=now\">This post up close \u203a</a>') AS text,\n       'ghost' AS tags\nFROM posts\nWHERE type = 'post' AND status = 'published' AND $__timeFilter(published_at)",
              "refId": "Anno"
            }
          },
          "enable": true,
          "hide": false,
          "iconColor": "#E535C8",
          "name": "Ghost posts (pink lines)"
        }
      },
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana-postgresql-datasource",
            "version": "v0",
            "datasource": {
              "name": "postiz-pg"
            },
            "spec": {
              "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "postiz-pg"
              },
              "editorMode": "code",
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT p.\"publishDate\" AS time,\n       initcap(replace(replace(i.\"providerIdentifier\", '-standalone', ''), '-', ' ')) || ': ' ||\n       left(regexp_replace(p.content, '<[^>]+>', '', 'g'), 100) ||\n       CASE WHEN i.\"providerIdentifier\" IN ('instagram', 'instagram-standalone', 'youtube', 'bluesky', 'threads', 'tiktok', 'tiktok-business')\n       THEN '<br><a href=\"/d/puppi3-post?var-network=' || replace(replace(i.\"providerIdentifier\", '-standalone', ''), '-business', '') ||\n       '&var-time=' || (extract(epoch FROM p.\"publishDate\") * 1000)::bigint ||\n       '&from=' || (extract(epoch FROM p.\"publishDate\") * 1000)::bigint || '&to=now\">This post up close \u203a</a>' ELSE '' END AS text,\n       'social,' || i.\"providerIdentifier\" AS tags\nFROM \"Post\" p JOIN \"Integration\" i ON i.id = p.\"integrationId\"\nWHERE p.\"deletedAt\" IS NULL AND p.\"parentPostId\" IS NULL AND p.state = 'PUBLISHED'\n  AND $__timeFilter(p.\"publishDate\")",
              "refId": "Anno"
            }
          },
          "enable": true,
          "hide": false,
          "iconColor": "#B28CFF",
          "name": "Social posts (violet lines)"
        }
      }
    ]
  }
