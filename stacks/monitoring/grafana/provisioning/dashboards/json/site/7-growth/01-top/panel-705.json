{
  "kind": "Panel",
  "spec": {
    "id": 705,
    "title": "Posts published",
    "description": "Ghost posts published in the time range (they're the pink markers on the chart below).",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "mysql",
                "version": "v0",
                "datasource": {
                  "name": "ghost-mysql"
                },
                "spec": {
                  "editorMode": "code",
                  "format": "table",
                  "rawQuery": true,
                  "rawSql": "SELECT COUNT(*) AS posts FROM posts WHERE type = 'post' AND status = 'published' AND $__timeFilter(published_at)"
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "stat",
      "version": "",
      "spec": {
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                }
              ]
            },
            "color": {
              "mode": "fixed",
              "fixedColor": "#E535C8"
            },
            "noValue": "0"
          },
          "overrides": []
        }
      }
    }
  }
}
