{
  "kind": "Panel",
  "spec": {
    "id": 724,
    "title": "Posts vs bio links",
    "description": "Visitors and signups by how the tagged link was shared (?utm_medium=\u2026): social = links the social bridge put in posts, captions and Stories, plus the /d/ Discord and /y/ YouTube links you share by hand (@SITE_HOST@/d/<post>, /y/<post>); bio = the bio short links (@SITE_HOST@/ig, /bsky, /th, /tk, /dis, /yt). Anything else is a medium someone else tagged (a newsletter, an ad). Untagged visits aren't counted here.",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "ghost-analytics"
                },
                "spec": {
                  "columns": [
                    {
                      "selector": "utm_medium",
                      "text": "Shared as",
                      "type": "string"
                    },
                    {
                      "selector": "visits",
                      "text": "Visitors",
                      "type": "number"
                    }
                  ],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "data",
                  "source": "url",
                  "type": "json",
                  "url": "http://tinybird-local:7181/v0/pipes/api_top_utm_mediums.json",
                  "url_options": {
                    "data": "",
                    "method": "GET",
                    "params": [
                      {
                        "key": "site_uuid",
                        "value": "@GHOST_SITE_UUID@"
                      },
                      {
                        "key": "timezone",
                        "value": "@SITE_TIMEZONE@"
                      },
                      {
                        "key": "date_from",
                        "value": "${__from:date:YYYY-MM-DD}"
                      },
                      {
                        "key": "date_to",
                        "value": "${__to:date:YYYY-MM-DD}"
                      },
                      {
                        "key": "limit",
                        "value": "50"
                      }
                    ]
                  }
                }
              },
              "refId": "A",
              "hidden": false
            }
          },
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "mysql",
                "version": "v0",
                "datasource": {
                  "name": "ghost-mysql"
                },
                "spec": {
                  "editorMode": "code",
                  "format": "table",
                  "rawQuery": true,
                  "rawSql": "SELECT utm_medium AS `Shared as`, COUNT(*) AS Members\nFROM members_created_events\nWHERE utm_medium IS NOT NULL AND utm_medium <> '' AND $__timeFilter(created_at) GROUP BY 1"
                }
              },
              "refId": "B",
              "hidden": false
            }
          }
        ],
        "transformations": [
          {
            "kind": "Transformation",
            "group": "joinByField",
            "spec": {
              "options": {
                "byField": "Shared as",
                "mode": "outer"
              }
            }
          },
          {
            "kind": "Transformation",
            "group": "renameByRegex",
            "spec": {
              "options": {
                "regex": "^(.*) A$",
                "renamePattern": "$1"
              }
            }
          },
          {
            "kind": "Transformation",
            "group": "calculateField",
            "spec": {
              "options": {
                "alias": "Visitor \u2192 member",
                "binary": {
                  "left": {
                    "matcher": {
                      "id": "byName",
                      "options": "Members"
                    }
                  },
                  "operator": "/",
                  "right": {
                    "matcher": {
                      "id": "byName",
                      "options": "Visitors"
                    }
                  }
                },
                "mode": "binary",
                "replaceFields": false
              }
            }
          },
          {
            "kind": "Transformation",
            "group": "sortBy",
            "spec": {
              "options": {
                "sort": [
                  {
                    "desc": true,
                    "field": "Visitors"
                  }
                ]
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "table",
      "version": "",
      "spec": {
        "options": {
          "cellHeight": "sm",
          "footer": {
            "fields": "",
            "reducer": [
              "sum"
            ],
            "show": false
          },
          "showHeader": true,
          "sortBy": [
            {
              "desc": true,
              "displayName": "Visitors"
            }
          ]
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              },
              "filterable": true
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Visitor \u2192 member"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percentunit"
                },
                {
                  "id": "decimals",
                  "value": 1
                },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "options": {
                        "match": "nan",
                        "result": {
                          "text": "0%"
                        }
                      },
                      "type": "special"
                    },
                    {
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "0%"
                        }
                      },
                      "type": "special"
                    }
                  ]
                },
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-text"
                  }
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "continuous-RdYlGr"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Visitors"
              },
              "properties": [
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "mode": "basic",
                    "type": "gauge",
                    "valueDisplayMode": "text"
                  }
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "purple"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Shared as"
              },
              "properties": [
                {
                  "id": "mappings",
                  "value": [
                    {
                      "options": {
                        "bio": {
                          "index": 1,
                          "text": "Bio links"
                        },
                        "social": {
                          "index": 0,
                          "text": "Social posts (bridge links + Discord /d/ + YouTube /y/ links)"
                        }
                      },
                      "type": "value"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  }
}
