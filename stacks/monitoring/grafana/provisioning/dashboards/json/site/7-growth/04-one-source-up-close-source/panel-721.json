{
  "kind": "Panel",
  "spec": {
    "id": 721,
    "title": "Unique visitors per day from ${source:text}",
    "description": "Pick the source at the top of the dashboard. With the social post markers, this shows whether posting on a network brings visitors from it, and how long the effect lasts.",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "ghost-analytics"
                },
                "spec": {
                  "columns": [
                    {
                      "selector": "date",
                      "text": "Date",
                      "type": "string"
                    },
                    {
                      "selector": "visits",
                      "text": "Unique visitors",
                      "type": "number"
                    }
                  ],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "data",
                  "source": "url",
                  "type": "json",
                  "url": "http://tinybird-local:7181/v0/pipes/api_kpis.json",
                  "url_options": {
                    "data": "",
                    "method": "GET",
                    "params": [
                      {
                        "key": "site_uuid",
                        "value": "@GHOST_SITE_UUID@"
                      },
                      {
                        "key": "timezone",
                        "value": "@SITE_TIMEZONE@"
                      },
                      {
                        "key": "date_from",
                        "value": "${__from:date:YYYY-MM-DD}"
                      },
                      {
                        "key": "date_to",
                        "value": "${__to:date:YYYY-MM-DD}"
                      },
                      {
                        "key": "source",
                        "value": "${source}"
                      }
                    ]
                  }
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [
          {
            "kind": "Transformation",
            "group": "convertFieldType",
            "spec": {
              "options": {
                "conversions": [
                  {
                    "dateFormat": "YYYY-MM-DD",
                    "destinationType": "time",
                    "targetField": "Date",
                    "timezone": "@SITE_TIMEZONE@"
                  }
                ],
                "fields": {}
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "timeseries",
      "version": "13.0.2",
      "spec": {
        "options": {
          "legend": {
            "calcs": [],
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "fieldConfig": {
          "defaults": {
            "decimals": 0,
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            },
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "barAlignment": 0,
              "drawStyle": "bars",
              "fillOpacity": 60,
              "lineWidth": 1,
              "showPoints": "never"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byFrameRefID",
                "options": "A"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Unique visitors"
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "purple",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        }
      }
    }
  }
}
