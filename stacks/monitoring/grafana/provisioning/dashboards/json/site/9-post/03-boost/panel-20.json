{
  "kind": "Panel",
  "spec": {
    "id": 20,
    "title": "Its boost: what it cost and bought (${post_boost_currency})",
    "description": "This post's boosts added up (all of them, if it was boosted more than once): what they cost, how many they reached (Instagram) or paid views they got (TikTok), the cost per 1000 of those and the follows they brought. Instagram's come from the Meta ad account, TikTok's are what you typed in on the Boosts page.",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "bridge-instagram"
                },
                "spec": {
                  "columns": [
                    {
                      "selector": "spend",
                      "text": "Spent",
                      "type": "number"
                    },
                    {
                      "selector": "seen",
                      "text": "Seen",
                      "type": "number"
                    },
                    {
                      "selector": "cpm",
                      "text": "Per 1000 seen",
                      "type": "number"
                    },
                    {
                      "selector": "follows",
                      "text": "Follows",
                      "type": "number"
                    },
                    {
                      "selector": "costPerFollow",
                      "text": "Per follow",
                      "type": "number"
                    }
                  ],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "boost",
                  "source": "url",
                  "type": "json",
                  "url": "http://postiz-ghost-bridge:8080/post.json",
                  "url_options": {
                    "data": "",
                    "method": "GET",
                    "params": [
                      {
                        "key": "network",
                        "value": "${network}"
                      },
                      {
                        "key": "id",
                        "value": "${post}"
                      },
                      {
                        "key": "time",
                        "value": "${time}"
                      }
                    ]
                  }
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [
          {
            "kind": "Transformation",
            "group": "organize",
            "spec": {
              "options": {
                "excludeByName": {},
                "indexByName": {
                  "Spent": 0,
                  "Seen": 1,
                  "Per 1000 seen": 2,
                  "Follows": 3,
                  "Per follow": 4
                },
                "renameByName": {}
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "stat",
      "version": "13.0.2",
      "spec": {
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "value_and_name",
          "orientation": "vertical",
          "wideLayout": false,
          "text": {
            "titleSize": 12
          }
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            },
            "color": {
              "mode": "fixed",
              "fixedColor": "#B28CFF"
            },
            "noValue": "\u2013"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Spent"
              },
              "properties": [
                {
                  "id": "decimals",
                  "value": 2
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Per 1000 seen"
              },
              "properties": [
                {
                  "id": "decimals",
                  "value": 2
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Per follow"
              },
              "properties": [
                {
                  "id": "decimals",
                  "value": 2
                }
              ]
            }
          ]
        }
      }
    }
  }
}
