{
  "kind": "Panel",
  "spec": {
    "id": 17,
    "title": "Members who joined there, by source",
    "description": "New members who signed up on the page, by where they came from (our link tag first, else the referrer). In the dashboard's time range, which starts when the post went up (opened from Platforms). Empty when no site page was found for the post (see the top).",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "mysql",
                "version": "v0",
                "datasource": {
                  "name": "ghost-mysql"
                },
                "spec": {
                  "editorMode": "code",
                  "format": "table",
                  "rawQuery": true,
                  "rawSql": "-- the page (and source names) arrive URL-encoded in a double-quoted literal, the one form Grafana can't let\n-- a quote or backslash out of, and are decoded here\nWITH v AS (SELECT REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(\"${page:percentencode}\", '%2F', '/'), '%3F', '?'), '%3D', '='), '%26', '&'), '%23', '#'), '%2B', '+'), '%3A', ':'), '%2C', ','), '%3B', ';'), '%40', '@'), '%20', ' '), '%5E', '^'), '%7C', '|'), '%24', '$'), '%5B', '['), '%5D', ']'), '%28', '('), '%29', ')'), '%21', '!'), '%2A', '*'), '%25', '%') AS page)\nSELECT COALESCE(NULLIF(m.utm_source, ''), IF(m.referrer_source IN ('', 'Direct'), '', m.referrer_source), '') AS Source, COUNT(*) AS Members\nFROM members_created_events m, v\nWHERE (m.attribution_url = v.page\n  OR m.attribution_id IN (SELECT id FROM posts WHERE CONCAT('/', slug, '/') = v.page))\n  AND $__timeFilter(m.created_at)\nGROUP BY 1 ORDER BY 2 DESC"
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "table",
      "version": "13.0.2",
      "spec": {
        "options": {
          "cellHeight": "sm",
          "showHeader": true
        },
        "fieldConfig": {
          "defaults": {
            "noValue": "\u2013",
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              }
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Source"
              },
              "properties": [
                {
                  "id": "mappings",
                  "value": [
                    {
                      "options": {
                        "Facebook": {
                          "index": 0,
                          "text": "Facebook (mostly Instagram links)"
                        },
                        "bluesky": {
                          "index": 4,
                          "text": "Bluesky (tag: bluesky)"
                        },
                        "discord": {
                          "index": 7,
                          "text": "Discord (tag: discord)"
                        },
                        "facebook": {
                          "index": 8,
                          "text": "Facebook (tag: facebook)"
                        },
                        "ig": {
                          "index": 2,
                          "text": "Instagram (tag: ig, set by Instagram)"
                        },
                        "instagram": {
                          "index": 3,
                          "text": "Instagram (tag: instagram)"
                        },
                        "@SITE_HOST@": {
                          "index": 1,
                          "text": "Your own site"
                        },
                        "threads": {
                          "index": 5,
                          "text": "Threads (tag: threads)"
                        },
                        "tiktok": {
                          "index": 6,
                          "text": "TikTok (tag: tiktok)"
                        },
                        "x": {
                          "index": 9,
                          "text": "X (tag: x)"
                        },
                        "youtube": {
                          "index": 10,
                          "text": "YouTube (tag: youtube)"
                        }
                      },
                      "type": "value"
                    },
                    {
                      "options": {
                        "match": "empty",
                        "result": {
                          "text": "Direct / unknown"
                        }
                      },
                      "type": "special"
                    },
                    {
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Direct / unknown"
                        }
                      },
                      "type": "special"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  }
}
