{
  "kind": "Panel",
  "spec": {
    "id": 6,
    "title": "${compare:text}: this post vs your typical ${label} post",
    "description": "This post's total each day next to the typical (median) other ${label} post's total at the same age. The typical line has gaps where fewer than 3 other posts have that day kept (see the table).",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "bridge-instagram"
                },
                "spec": {
                  "columns": [],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "compare",
                  "source": "url",
                  "type": "json",
                  "url": "http://postiz-ghost-bridge:8080/post.json",
                  "url_options": {
                    "data": "",
                    "method": "GET",
                    "params": [
                      {
                        "key": "network",
                        "value": "${network}"
                      },
                      {
                        "key": "id",
                        "value": "${post}"
                      },
                      {
                        "key": "time",
                        "value": "${time}"
                      },
                      {
                        "key": "compare",
                        "value": "${compare}"
                      }
                    ]
                  }
                }
              },
              "refId": "A",
              "hidden": false
            }
          },
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "bridge-instagram"
                },
                "spec": {
                  "columns": [
                    {
                      "selector": "color",
                      "text": "color",
                      "type": "string"
                    }
                  ],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "[$merge([{\"color\": \"${colour}\"}])]",
                  "source": "inline",
                  "type": "json",
                  "data": "[{}]"
                }
              },
              "refId": "Colour",
              "hidden": false
            }
          }
        ],
        "transformations": [
          {
            "kind": "Transformation",
            "group": "convertFieldType",
            "spec": {
              "options": {
                "conversions": [
                  {
                    "destinationType": "time",
                    "targetField": "time"
                  }
                ],
                "fields": {}
              }
            }
          },
          {
            "kind": "Transformation",
            "group": "configFromData",
            "spec": {
              "options": {
                "configRefId": "Colour",
                "mappings": [
                  {
                    "fieldName": "color",
                    "handlerKey": "color"
                  }
                ],
                "applyTo": {
                  "id": "byName",
                  "options": "This post"
                }
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "timeseries",
      "version": "13.0.2",
      "spec": {
        "options": {
          "legend": {
            "calcs": [],
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "fieldConfig": {
          "defaults": {
            "decimals": 0,
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            },
            "color": {
              "mode": "fixed",
              "fixedColor": "#B28CFF"
            },
            "noValue": "\u2013",
            "custom": {
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineWidth": 2,
              "showPoints": "auto",
              "spanNulls": false
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Typical post"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "text",
                    "mode": "fixed"
                  }
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "dash": [
                      10,
                      10
                    ],
                    "fill": "dash"
                  }
                }
              ]
            }
          ]
        }
      }
    }
  }
}
