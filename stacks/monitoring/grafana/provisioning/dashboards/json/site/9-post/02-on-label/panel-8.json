{
  "kind": "Panel",
  "spec": {
    "id": 8,
    "title": "Why",
    "description": "vs your usual: the numbers that lifted it most and held it back most, as a multiple of your usual post, and what it was compared with. vs industry: this post's rate and the published average it's compared with.",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "bridge-instagram"
                },
                "spec": {
                  "columns": [
                    {
                      "selector": "why",
                      "text": "vs your usual",
                      "type": "string"
                    },
                    {
                      "selector": "industry",
                      "text": "vs industry",
                      "type": "string"
                    }
                  ],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "performance",
                  "source": "url",
                  "type": "json",
                  "url": "http://postiz-ghost-bridge:8080/post.json",
                  "url_options": {
                    "data": "",
                    "method": "GET",
                    "params": [
                      {
                        "key": "network",
                        "value": "${network}"
                      },
                      {
                        "key": "id",
                        "value": "${post}"
                      },
                      {
                        "key": "time",
                        "value": "${time}"
                      }
                    ]
                  }
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [
          {
            "kind": "Transformation",
            "group": "organize",
            "spec": {
              "options": {
                "indexByName": {
                  "vs your usual": 0,
                  "vs industry": 1
                },
                "excludeByName": {},
                "renameByName": {}
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "table",
      "version": "13.0.2",
      "spec": {
        "options": {
          "cellHeight": "sm",
          "showHeader": true
        },
        "fieldConfig": {
          "defaults": {
            "noValue": "No verdict for this post yet: see The post above for why",
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto",
                "wrapText": true
              }
            }
          },
          "overrides": []
        }
      }
    }
  }
}
