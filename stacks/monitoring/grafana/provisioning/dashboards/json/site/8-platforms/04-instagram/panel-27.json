{
  "kind": "Panel",
  "spec": {
    "id": 27,
    "title": "Instagram profile views & link taps ${chart}",
    "description": "Per day (time ranges over 7 days): Profile views = how many times your Instagram profile was seen; Link taps = taps on the links on your profile, your @SITE_HOST@ bio link among them (Instagram doesn't split them by link: the site's side is Growth's \"Tagged links\", bio link). From Instagram's insights, one day (UTC) at a time: the last 30 days when the bridge starts, every day after. The thin dashed line is each day's number, the bold one the 7-day average (of the days the bridge has among the 7 ending that day; it starts once 4 of them are there): the trend, through the day-to-day ups and downs. Violet lines are this network's posts: hover one to see what went out; a rise just after one is that post working. Hour by hour (when the time range is 7 days or less): what came in between the bridge's checks (about once an hour; a point after a gap covers the gap), no 7-day line. Kept for the last 90 days (ACCOUNT_CHECK_DAYS); further back, pick per day. Both follow the dashboard's time range. Instagram is asked at most once an hour. Needs POSTIZ_DB_PASSWORD.",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "bridge-instagram"
                },
                "spec": {
                  "columns": [
                    {
                      "selector": "date",
                      "text": "Date",
                      "type": "string"
                    },
                    {
                      "selector": "profileViews",
                      "text": "Profile views",
                      "type": "number"
                    },
                    {
                      "selector": "profileViews7",
                      "text": "Profile views, 7-day average",
                      "type": "number"
                    },
                    {
                      "selector": "linkTaps",
                      "text": "Link taps",
                      "type": "number"
                    },
                    {
                      "selector": "linkTaps7",
                      "text": "Link taps, 7-day average",
                      "type": "number"
                    }
                  ],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "\"${chart}\" = \"hour by hour\" ? [] : daily",
                  "source": "url",
                  "type": "json",
                  "url": "http://postiz-ghost-bridge:8080/instagram.json",
                  "url_options": {
                    "data": "",
                    "method": "GET"
                  }
                }
              },
              "refId": "A",
              "hidden": false
            }
          },
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "bridge-instagram"
                },
                "spec": {
                  "columns": [
                    {
                      "selector": "time",
                      "text": "Time",
                      "type": "timestamp_epoch"
                    },
                    {
                      "selector": "profileViews",
                      "text": "Profile views",
                      "type": "number"
                    },
                    {
                      "selector": "linkTaps",
                      "text": "Link taps",
                      "type": "number"
                    }
                  ],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "\"${chart}\" = \"hour by hour\" ? checks : []",
                  "source": "url",
                  "type": "json",
                  "url": "http://postiz-ghost-bridge:8080/account.json?network=instagram",
                  "url_options": {
                    "data": "",
                    "method": "GET"
                  }
                }
              },
              "refId": "B",
              "hidden": false
            }
          }
        ],
        "transformations": [
          {
            "kind": "Transformation",
            "group": "convertFieldType",
            "spec": {
              "options": {
                "conversions": [
                  {
                    "dateFormat": "YYYY-MM-DD",
                    "destinationType": "time",
                    "targetField": "Date",
                    "timezone": "utc"
                  }
                ],
                "fields": {}
              }
            }
          },
          {
            "kind": "Transformation",
            "group": "organize",
            "spec": {
              "options": {
                "excludeByName": {},
                "indexByName": {
                  "Date": 0,
                  "Profile views": 1,
                  "Profile views, 7-day average": 2,
                  "Link taps": 3,
                  "Link taps, 7-day average": 4
                },
                "renameByName": {}
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "timeseries",
      "version": "13.0.2",
      "spec": {
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            },
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto",
              "spanNulls": false
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Profile views"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#E1306C"
                  }
                },
                {
                  "id": "custom.lineWidth",
                  "value": 1
                },
                {
                  "id": "custom.fillOpacity",
                  "value": 0
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "fill": "dash",
                    "dash": [
                      4,
                      4
                    ]
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Profile views, 7-day average"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#E1306C"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Link taps"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#F58529"
                  }
                },
                {
                  "id": "custom.lineWidth",
                  "value": 1
                },
                {
                  "id": "custom.fillOpacity",
                  "value": 0
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "fill": "dash",
                    "dash": [
                      4,
                      4
                    ]
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Link taps, 7-day average"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#F58529"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byFrameRefID",
                "options": "B"
              },
              "properties": [
                {
                  "id": "custom.lineInterpolation",
                  "value": "linear"
                },
                {
                  "id": "custom.lineWidth",
                  "value": 2
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "fill": "solid"
                  }
                },
                {
                  "id": "custom.fillOpacity",
                  "value": 10
                },
                {
                  "id": "displayName",
                  "value": "${__field.name}"
                }
              ]
            }
          ]
        }
      }
    }
  }
}
