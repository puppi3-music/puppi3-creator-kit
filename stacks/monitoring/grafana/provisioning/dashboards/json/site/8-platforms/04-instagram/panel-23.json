{
  "kind": "Panel",
  "spec": {
    "id": 23,
    "title": "Instagram: followers & profile",
    "description": "From Instagram's Graph API via the bridge: followers and posts now; profile views and link taps over the last 30 days. Profile views = times your profile was seen; Link taps = taps on the links on it (your @SITE_HOST@ bio link among them). Not affected by the dashboard's time range.",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "bridge-instagram"
                },
                "spec": {
                  "columns": [
                    {
                      "selector": "followers",
                      "text": "Followers",
                      "type": "number"
                    },
                    {
                      "selector": "posts",
                      "text": "Posts (all time)",
                      "type": "number"
                    },
                    {
                      "selector": "profileViews30",
                      "text": "Profile views",
                      "type": "number"
                    },
                    {
                      "selector": "linkTaps30",
                      "text": "Link taps",
                      "type": "number"
                    }
                  ],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "totals",
                  "source": "url",
                  "type": "json",
                  "url": "http://postiz-ghost-bridge:8080/instagram.json",
                  "url_options": {
                    "data": "",
                    "method": "GET"
                  }
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [
          {
            "kind": "Transformation",
            "group": "organize",
            "spec": {
              "options": {
                "excludeByName": {},
                "indexByName": {
                  "Followers": 0,
                  "Posts (all time)": 1,
                  "Profile views": 2,
                  "Link taps": 3
                },
                "renameByName": {}
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "stat",
      "version": "13.0.2",
      "spec": {
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "value_and_name",
          "orientation": "vertical",
          "wideLayout": false,
          "text": {
            "titleSize": 12
          }
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            },
            "color": {
              "mode": "fixed",
              "fixedColor": "#E1306C"
            },
            "noValue": "\u2013"
          },
          "overrides": []
        }
      }
    }
  }
}
