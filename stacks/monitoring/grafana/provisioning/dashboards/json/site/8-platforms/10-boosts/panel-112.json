{
  "kind": "Panel",
  "spec": {
    "id": 112,
    "title": "Follows from boosts, last 30 days",
    "description": "Follows the boosts brought (Instagram counts them per ad; on TikTok, what Promote showed), the cost of one, and how many boosts ran in the last 30 days and are running now. Not affected by the dashboard's time range.",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "bridge-instagram"
                },
                "spec": {
                  "columns": [
                    {
                      "selector": "follows30",
                      "text": "Follows",
                      "type": "number"
                    },
                    {
                      "selector": "costPerFollow30",
                      "text": "Per follow",
                      "type": "number"
                    },
                    {
                      "selector": "boosts30",
                      "text": "Boosts",
                      "type": "number"
                    },
                    {
                      "selector": "running",
                      "text": "Running now",
                      "type": "number"
                    }
                  ],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "totals",
                  "source": "url",
                  "type": "json",
                  "url": "http://postiz-ghost-bridge:8080/ads.json",
                  "url_options": {
                    "data": "",
                    "method": "GET"
                  }
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [
          {
            "kind": "Transformation",
            "group": "organize",
            "spec": {
              "options": {
                "excludeByName": {},
                "indexByName": {
                  "Follows": 0,
                  "Per follow": 1,
                  "Boosts": 2,
                  "Running now": 3
                },
                "renameByName": {}
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "stat",
      "version": "13.0.2",
      "spec": {
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "value_and_name",
          "orientation": "vertical",
          "wideLayout": false,
          "text": {
            "titleSize": 12
          }
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            },
            "color": {
              "mode": "fixed",
              "fixedColor": "#B28CFF"
            },
            "noValue": "\u2013"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Per follow"
              },
              "properties": [
                {
                  "id": "decimals",
                  "value": 2
                }
              ]
            }
          ]
        }
      }
    }
  }
}
