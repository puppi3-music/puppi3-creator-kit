{
  "kind": "Panel",
  "spec": {
    "id": 114,
    "title": "Spent per day (${boosts_currency})",
    "description": "What boosts cost each day, per network. Per day: the thin dashed line is each day's number, the bold one the 7-day average (days without a boost count as 0). Instagram's come from Meta per ad per day; a typed TikTok Promote's are spread evenly over its days, up to today while it runs.",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "bridge-instagram"
                },
                "spec": {
                  "columns": [
                    {
                      "selector": "date",
                      "text": "Date",
                      "type": "string"
                    },
                    {
                      "selector": "instagramSpend",
                      "text": "Instagram",
                      "type": "number"
                    },
                    {
                      "selector": "instagramSpend7",
                      "text": "Instagram, 7-day average",
                      "type": "number"
                    },
                    {
                      "selector": "tiktokSpend",
                      "text": "TikTok",
                      "type": "number"
                    },
                    {
                      "selector": "tiktokSpend7",
                      "text": "TikTok, 7-day average",
                      "type": "number"
                    },
                    {
                      "selector": "spend7",
                      "text": "All boosts, 7-day average",
                      "type": "number"
                    }
                  ],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "daily",
                  "source": "url",
                  "type": "json",
                  "url": "http://postiz-ghost-bridge:8080/ads.json",
                  "url_options": {
                    "data": "",
                    "method": "GET"
                  }
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [
          {
            "kind": "Transformation",
            "group": "convertFieldType",
            "spec": {
              "options": {
                "conversions": [
                  {
                    "dateFormat": "YYYY-MM-DD",
                    "destinationType": "time",
                    "targetField": "Date",
                    "timezone": "utc"
                  }
                ],
                "fields": {}
              }
            }
          },
          {
            "kind": "Transformation",
            "group": "organize",
            "spec": {
              "options": {
                "excludeByName": {},
                "indexByName": {
                  "Date": 0,
                  "Instagram": 1,
                  "Instagram, 7-day average": 2,
                  "TikTok": 3,
                  "TikTok, 7-day average": 4,
                  "All boosts, 7-day average": 5
                },
                "renameByName": {}
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "timeseries",
      "version": "13.0.2",
      "spec": {
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            },
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto",
              "spanNulls": false
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Instagram"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#E1306C"
                  }
                },
                {
                  "id": "custom.lineWidth",
                  "value": 1
                },
                {
                  "id": "custom.fillOpacity",
                  "value": 0
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "fill": "dash",
                    "dash": [
                      4,
                      4
                    ]
                  }
                },
                {
                  "id": "decimals",
                  "value": 2
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Instagram, 7-day average"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#E1306C"
                  }
                },
                {
                  "id": "decimals",
                  "value": 2
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "TikTok"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#25F4EE"
                  }
                },
                {
                  "id": "custom.lineWidth",
                  "value": 1
                },
                {
                  "id": "custom.fillOpacity",
                  "value": 0
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "fill": "dash",
                    "dash": [
                      4,
                      4
                    ]
                  }
                },
                {
                  "id": "decimals",
                  "value": 2
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "TikTok, 7-day average"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#25F4EE"
                  }
                },
                {
                  "id": "decimals",
                  "value": 2
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "All boosts, 7-day average"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  }
                },
                {
                  "id": "custom.hideFrom",
                  "value": {
                    "legend": true,
                    "tooltip": false,
                    "viz": true
                  }
                },
                {
                  "id": "decimals",
                  "value": 2
                }
              ]
            }
          ]
        }
      }
    }
  }
}
