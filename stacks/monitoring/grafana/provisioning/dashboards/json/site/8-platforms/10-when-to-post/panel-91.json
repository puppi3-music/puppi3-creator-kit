                  "Posts": 2,
                  "Night (0-6)": 3,
                  "Morning (6-12)": 4,
                  "Afternoon (12-18)": 5,
                  "Evening (18-24)": 6,
                  "Night (0-6) tip": 7,
                  "Night (0-6) style": 8,
                  "Morning (6-12) tip": 9,
                  "Morning (6-12) style": 10,
                  "Afternoon (12-18) tip": 11,
                  "Afternoon (12-18) style": 12,
                  "Evening (18-24) tip": 13,
                  "Evening (18-24) style": 14,
                  "Posts tip": 15
                },
                "excludeByName": {},
                "renameByName": {}
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
