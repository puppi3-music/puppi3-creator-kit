                  "parser": "backend",
                  "root_selector": "$append([], dayparts)",
                  "source": "url",
                  "type": "json",
                  "url": "http://postiz-ghost-bridge:8080/timing.json",
                  "url_options": {
                    "data": "",
                    "method": "GET",
                    "params": [
                      {
                        "key": "ghost",
                        "value": "${cmp_ghost}"
                      },
                      {
                        "key": "instagram",
                        "value": "${cmp_instagram}"
                      },
                      {
                        "key": "tiktok",
                        "value": "${cmp_tiktok}"
                      },
                      {
                        "key": "threads",
                        "value": "${cmp_threads}"
                      },
                      {
                        "key": "bluesky",
