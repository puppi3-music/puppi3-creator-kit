        "transformations": [
          {
            "kind": "Transformation",
            "group": "convertFieldType",
            "spec": {
              "options": {
                "conversions": [
                  {
                    "dateFormat": "YYYY-MM-DD",
                    "destinationType": "time",
                    "targetField": "Date",
                    "timezone": "utc"
