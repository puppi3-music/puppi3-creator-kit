                  "parser": "backend",
                  "root_selector": "\"${chart}\" = \"hour by hour\" ? checks : []",
                  "source": "url",
                  "type": "json",
                  "url": "http://postiz-ghost-bridge:8080/account.json?network=ghost",
                  "url_options": {
                    "data": "",
