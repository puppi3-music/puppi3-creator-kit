                ],
                "fields": {}
              }
            }
          },
          {
            "kind": "Transformation",
            "group": "organize",
            "spec": {
              "options": {
                "excludeByName": {},
                "indexByName": {
                  "Date": 0,
                  "Visitors": 1,
                  "Visitors, 7-day average": 2,
                  "Engagement": 3,
                  "Engagement, 7-day average": 4,
                  "Engagement rate, 7-day": 5,
                  "New members": 6,
                  "Comments": 7,
                  "Link clicks": 8,
                  "Live plays": 9
                },
                "renameByName": {}
              }
            }
          }
        ],
        "queryOptions": {}
