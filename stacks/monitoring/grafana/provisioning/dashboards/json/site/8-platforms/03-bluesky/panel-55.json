                      "text": "Engagement",
                      "type": "number"
                    },
                    {
                      "selector": "newLikes",
                      "text": "Likes",
                      "type": "number"
                    },
                    {
                      "selector": "newReplies",
                      "text": "Replies",
                      "type": "number"
