{
  "kind": "Panel",
  "spec": {
    "id": 55,
    "title": "Bluesky engagement ${chart}",
    "description": "Per day (time ranges over 7 days): Engagement = likes, replies, reposts and quotes added up (UTC days), from what your posts gained each day, worked out from every post's numbers kept per day (Bluesky gives no numbers per day): all your posts, old ones too. A post the bridge first saw a day or more after it went up starts from what it had then; hover for each. The thin dashed line is each day's number, the bold one the 7-day average (of the days the bridge has among the 7 ending that day; it starts once 4 of them are there): the trend, through the day-to-day ups and downs. Engagement per 100 followers (right axis) = the week's engagement for every 100 followers: Bluesky gives no views, so it can't be a share of views like the other networks'. Violet lines are this network's posts: hover one to see what went out; a rise just after one is that post working. Hour by hour (when the time range is 7 days or less): what came in between the bridge's checks (about once an hour; a point after a gap covers the gap), no 7-day line. Kept for the last 90 days (ACCOUNT_CHECK_DAYS); further back, pick per day. Both follow the dashboard's time range. Hour by hour has no rate.",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "bridge-instagram"
                },
                "spec": {
                  "columns": [
                    {
                      "selector": "date",
                      "text": "Date",
                      "type": "string"
                    },
                    {
                      "selector": "engagement",
                      "text": "Engagement",
                      "type": "number"
                    },
                    {
                      "selector": "engagement7",
                      "text": "Engagement, 7-day average",
                      "type": "number"
                    },
                    {
                      "selector": "rate7",
                      "text": "Engagement per 100 followers, 7-day",
                      "type": "number"
                    },
                    {
                      "selector": "likes",
                      "text": "Likes",
                      "type": "number"
                    },
                    {
                      "selector": "replies",
                      "text": "Replies",
                      "type": "number"
                    },
                    {
                      "selector": "reposts",
                      "text": "Reposts",
                      "type": "number"
                    },
                    {
                      "selector": "quotes",
                      "text": "Quotes",
                      "type": "number"
                    }
                  ],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "\"${chart}\" = \"hour by hour\" ? [] : daily",
                  "source": "url",
                  "type": "json",
                  "url": "http://postiz-ghost-bridge:8080/bluesky.json",
                  "url_options": {
                    "data": "",
                    "method": "GET"
                  }
                }
              },
              "refId": "A",
              "hidden": false
            }
          },
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "bridge-instagram"
                },
                "spec": {
