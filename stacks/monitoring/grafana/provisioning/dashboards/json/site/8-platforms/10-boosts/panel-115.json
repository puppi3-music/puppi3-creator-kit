{
  "kind": "Panel",
  "spec": {
    "id": 115,
    "title": "Cost per 1000 seen, 7-day (${boosts_currency})",
    "description": "What 1000 people seeing a boost cost (reached on Instagram, paid views on TikTok), over the 7 days ending each day: lower is better value. In the hover, each day's seen and follows. Per day: the thin dashed line is each day's number, the bold one the 7-day average (days without a boost count as 0). Instagram's come from Meta per ad per day; a typed TikTok Promote's are spread evenly over its days, up to today while it runs.",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "bridge-instagram"
                },
                "spec": {
                  "columns": [
                    {
                      "selector": "date",
                      "text": "Date",
                      "type": "string"
                    },
                    {
                      "selector": "instagramCpm7",
                      "text": "Instagram",
                      "type": "number"
                    },
                    {
                      "selector": "tiktokCpm7",
                      "text": "TikTok",
                      "type": "number"
                    },
                    {
                      "selector": "instagramSeen",
                      "text": "Instagram seen",
                      "type": "number"
                    },
                    {
                      "selector": "tiktokSeen",
                      "text": "TikTok seen",
                      "type": "number"
                    },
                    {
                      "selector": "instagramFollows",
                      "text": "Instagram follows",
                      "type": "number"
                    },
                    {
                      "selector": "tiktokFollows",
                      "text": "TikTok follows",
                      "type": "number"
                    }
                  ],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "daily",
                  "source": "url",
                  "type": "json",
                  "url": "http://postiz-ghost-bridge:8080/ads.json",
                  "url_options": {
                    "data": "",
                    "method": "GET"
                  }
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [
          {
            "kind": "Transformation",
            "group": "convertFieldType",
            "spec": {
              "options": {
                "conversions": [
                  {
                    "dateFormat": "YYYY-MM-DD",
                    "destinationType": "time",
                    "targetField": "Date",
                    "timezone": "utc"
                  }
                ],
                "fields": {}
              }
            }
          },
          {
            "kind": "Transformation",
            "group": "organize",
            "spec": {
              "options": {
                "excludeByName": {},
                "indexByName": {
                  "Date": 0,
                  "Instagram": 1,
                  "TikTok": 2,
                  "Instagram seen": 3,
                  "TikTok seen": 4,
                  "Instagram follows": 5,
                  "TikTok follows": 6
                },
                "renameByName": {}
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "timeseries",
      "version": "13.0.2",
      "spec": {
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            },
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto",
              "spanNulls": false
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Instagram"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#E1306C"
                  }
                },
                {
                  "id": "decimals",
                  "value": 2
                },
                {
                  "id": "custom.axisLabel",
                  "value": "Per 1000 seen"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "TikTok"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#25F4EE"
                  }
                },
                {
                  "id": "decimals",
                  "value": 2
                },
                {
                  "id": "custom.axisLabel",
                  "value": "Per 1000 seen"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Instagram seen"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#E1306C"
                  }
                },
                {
                  "id": "custom.hideFrom",
                  "value": {
                    "legend": true,
                    "tooltip": false,
                    "viz": true
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "TikTok seen"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#25F4EE"
                  }
                },
                {
                  "id": "custom.hideFrom",
                  "value": {
                    "legend": true,
                    "tooltip": false,
                    "viz": true
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Instagram follows"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  }
                },
                {
                  "id": "custom.hideFrom",
                  "value": {
                    "legend": true,
                    "tooltip": false,
                    "viz": true
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "TikTok follows"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  }
                },
                {
                  "id": "custom.hideFrom",
                  "value": {
                    "legend": true,
                    "tooltip": false,
                    "viz": true
                  }
                }
              ]
            }
          ]
        }
      }
    }
  }
}
