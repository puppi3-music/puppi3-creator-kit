{
  "kind": "Panel",
  "spec": {
    "id": 116,
    "title": "Every boost (${boosts_currency})",
    "description": "One row per boost, newest first: its dates, budget, what it cost and bought so far. Seen = accounts reached (Instagram) or paid views (TikTok); From = Meta's ad account, or typed in on the Boosts page. A row opens its post on Post. Every boost the bridge has, whatever the time range.",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "bridge-instagram"
                },
                "spec": {
                  "columns": [
                    {
                      "selector": "start",
                      "text": "Started",
                      "type": "string"
                    },
                    {
                      "selector": "endShown",
                      "text": "Ended",
                      "type": "string"
                    },
                    {
                      "selector": "label",
                      "text": "Network",
                      "type": "string"
                    },
                    {
                      "selector": "title",
                      "text": "Post",
                      "type": "string"
                    },
                    {
                      "selector": "status",
                      "text": "Status",
                      "type": "string"
                    },
                    {
                      "selector": "budgetShown",
                      "text": "Budget",
                      "type": "string"
                    },
                    {
                      "selector": "spend",
                      "text": "Spent",
                      "type": "number"
                    },
                    {
                      "selector": "seen",
                      "text": "Seen",
                      "type": "number"
                    },
                    {
                      "selector": "cpm",
                      "text": "Per 1000 seen",
                      "type": "number"
                    },
                    {
                      "selector": "follows",
                      "text": "Follows",
                      "type": "number"
                    },
                    {
                      "selector": "costPerFollow",
                      "text": "Per follow",
                      "type": "number"
                    },
                    {
                      "selector": "profileVisits",
                      "text": "Profile visits",
                      "type": "number"
                    },
                    {
                      "selector": "linkClicks",
                      "text": "Link clicks",
                      "type": "number"
                    },
                    {
                      "selector": "likes",
                      "text": "Likes",
                      "type": "number"
                    },
                    {
                      "selector": "sourceShown",
                      "text": "From",
                      "type": "string"
                    },
                    {
                      "selector": "permalink",
                      "text": "Link",
                      "type": "string"
                    },
                    {
                      "selector": "network",
                      "text": "network",
                      "type": "string"
                    },
                    {
                      "selector": "ref",
                      "text": "ref",
                      "type": "string"
                    },
                    {
                      "selector": "posted_ms",
                      "text": "posted_ms",
                      "type": "string"
                    }
                  ],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "$map(ads, function($a) { $merge([$a, {\"endShown\": $a.end ? $a.end : \"running\", \"budgetShown\": $a.budget != null ? $string($a.budget) & \" \" & $a.budgetPer : \"\", \"sourceShown\": $a.source = \"typed\" ? \"typed in\" : \"Meta\"}]) })",
                  "source": "url",
                  "type": "json",
                  "url": "http://postiz-ghost-bridge:8080/ads.json",
                  "url_options": {
                    "data": "",
                    "method": "GET"
                  }
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [
          {
            "kind": "Transformation",
            "group": "organize",
            "spec": {
              "options": {
                "excludeByName": {},
                "indexByName": {
                  "Started": 0,
                  "Ended": 1,
                  "Network": 2,
                  "Post": 3,
                  "Status": 4,
                  "Budget": 5,
                  "Spent": 6,
                  "Seen": 7,
                  "Per 1000 seen": 8,
                  "Follows": 9,
                  "Per follow": 10,
                  "Profile visits": 11,
                  "Link clicks": 12,
                  "Likes": 13,
                  "From": 14,
                  "Link": 15,
                  "network": 16,
                  "ref": 17,
                  "posted_ms": 18
                },
                "renameByName": {}
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "table",
      "version": "13.0.2",
      "spec": {
        "options": {
          "cellHeight": "sm",
          "showHeader": true
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            },
            "color": {
              "mode": "palette-classic"
            },
            "noValue": "\u2013",
            "custom": {
              "minWidth": 70
            },
            "links": [
              {
                "title": "This post up close: its numbers per day, its boost and what it did for the site",
                "url": "/d/puppi3-post?var-network=${__data.fields.network}&var-post=${__data.fields.ref}&from=${__data.fields.posted_ms}&to=now"
              }
            ]
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Spent"
              },
              "properties": [
                {
                  "id": "decimals",
                  "value": 2
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Per 1000 seen"
              },
              "properties": [
                {
                  "id": "decimals",
                  "value": 2
                },
                {
                  "id": "custom.minWidth",
                  "value": 105
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Per follow"
              },
              "properties": [
                {
                  "id": "decimals",
                  "value": 2
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Post"
              },
              "properties": [
                {
                  "id": "custom.minWidth",
                  "value": 200
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Link"
              },
              "properties": [
                {
                  "id": "links",
                  "value": [
                    {
                      "targetBlank": true,
                      "title": "Open the post",
                      "url": "${__value.raw}"
                    }
                  ]
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "network"
              },
              "properties": [
                {
                  "id": "custom.hidden",
                  "value": true
                },
                {
                  "id": "custom.hideFrom",
                  "value": {
                    "viz": true,
                    "legend": false,
                    "tooltip": false
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "ref"
              },
              "properties": [
                {
                  "id": "custom.hidden",
                  "value": true
                },
                {
                  "id": "custom.hideFrom",
                  "value": {
                    "viz": true,
                    "legend": false,
                    "tooltip": false
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "posted_ms"
              },
              "properties": [
                {
                  "id": "custom.hidden",
                  "value": true
                },
                {
                  "id": "custom.hideFrom",
                  "value": {
                    "viz": true,
                    "legend": false,
                    "tooltip": false
                  }
                }
              ]
            }
          ]
        }
      }
    }
  }
}
