{
  "kind": "Panel",
  "spec": {
    "id": 17,
    "title": "Instagram: reach (30 days)",
    "description": "Summed over the last 30 days. Stories = how many you posted, Story views = their views added up (each Story's last numbers before it went). Not affected by the dashboard's time range.",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "group": "yesoreyeram-infinity-datasource",
                "version": "v0",
                "datasource": {
                  "name": "bridge-instagram"
                },
                "spec": {
                  "columns": [
                    {
                      "selector": "reach",
                      "text": "Reach",
                      "type": "number"
                    },
                    {
                      "selector": "views",
                      "text": "Views",
                      "type": "number"
                    },
                    {
                      "selector": "stories30",
                      "text": "Stories",
                      "type": "number"
                    },
                    {
                      "selector": "storyViews30",
                      "text": "Story views",
                      "type": "number"
                    }
                  ],
                  "filters": [],
                  "format": "table",
                  "parser": "backend",
                  "root_selector": "totals",
                  "source": "url",
                  "type": "json",
                  "url": "http://postiz-ghost-bridge:8080/instagram.json",
                  "url_options": {
                    "data": "",
                    "method": "GET"
                  }
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [
          {
            "kind": "Transformation",
            "group": "organize",
            "spec": {
              "options": {
                "excludeByName": {},
                "indexByName": {
                  "Reach": 0,
                  "Views": 1,
                  "Stories": 2,
                  "Story views": 3
                },
                "renameByName": {}
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "stat",
      "version": "13.0.2",
      "spec": {
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "value_and_name",
          "orientation": "vertical",
          "wideLayout": false,
          "text": {
            "titleSize": 12
          }
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            },
            "color": {
              "mode": "fixed",
              "fixedColor": "#E1306C"
            },
            "noValue": "\u2013"
          },
          "overrides": []
        }
      }
    }
  }
}
