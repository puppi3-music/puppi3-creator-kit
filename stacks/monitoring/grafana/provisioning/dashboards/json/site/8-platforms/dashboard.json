              "rawSql": "SELECT published_at AS time,\n       CONCAT('Published: ', title, '<br><a href=\"/d/puppi3-post?var-network=ghost&var-post=', id,\n              '&from=', CAST(UNIX_TIMESTAMP(published_at) * 1000 AS UNSIGNED), '&to=now\">This post up close \u203a</a>') AS text,\n       'ghost' AS tags\nFROM posts\nWHERE type = 'post' AND status = 'published' AND $__timeFilter(published_at)",
