{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "puppi3-platforms"
  },
  "spec": {
    "title": "puppi3 \u00b7 Platforms",
    "description": "Each network's own numbers (followers, plays, reach, per-post stats), collected by the Postiz bridge",
    "tags": [
      "puppi3",
      "social"
    ],
    "editable": true,
    "cursorSync": "Crosshair",
    "liveNow": false,
    "preload": false,
    "timeSettings": {
      "timezone": "browser",
      "from": "now-30d",
      "to": "now",
      "autoRefresh": "5m",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
