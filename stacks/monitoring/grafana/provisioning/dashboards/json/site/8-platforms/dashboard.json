    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "has_ghost",
          "label": "Ghost has numbers",
          "description": "yes when the bridge's ghost.json has any numbers (now or from earlier days); no shows the Ghost section only to editors. Hidden: it only drives the section's show/hide rule.",
          "hide": "hideVariable",
          "refresh": "onDashboardLoad",
          "skipUrlSync": true,
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "query": {
            "kind": "DataQuery",
            "group": "yesoreyeram-infinity-datasource",
            "version": "v0",
            "datasource": {
              "name": "bridge-instagram"
            },
            "spec": {
              "refId": "has_ghost",
              "queryType": "infinity",
              "infinityQuery": {
                "refId": "has_ghost",
                "type": "json",
                "source": "url",
                "parser": "backend",
                "format": "table",
                "url": "http://postiz-ghost-bridge:8080/ghost.json",
                "url_options": {
                  "method": "GET",
                  "data": ""
                },
                "root_selector": "($count(totals.*[$type($) = \"number\"]) > 0 or $count(daily) > 0 or $count(posts) > 0 or $count(videos) > 0 or $count(tracks) > 0 or $count(uploads) > 0 or $count($keys(history)) > 0 or $count(followerHistory) > 0) ? \"yes\" : \"no\"",
                "columns": [],
                "filters": []
              }
            }
          },
          "definition": "",
          "regex": "",
          "sort": "disabled",
          "multi": false,
          "includeAll": false,
          "allowCustomValue": false
        }
      },
