    {
      "id": 207,
      "type": "table",
      "title": "Where signups came from",
      "description": " \"Facebook\" is mostly Instagram: Instagram often sends people through a Facebook address when they tap a link. \"Your own site\" is visits that started on @SITE_HOST@ itself (you, from Ghost Admin or previews, or someone still browsing past midnight), not a source to grow.",
      "datasource": {
        "type": "mysql",
        "uid": "ghost-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT IF(COALESCE(referrer_source, '') IN ('', 'Direct'), 'Direct / unknown', referrer_source) AS Source, COUNT(*) AS Signups\nFROM members_created_events\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 15",
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "ghost-mysql"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Source"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Facebook": {
                        "text": "Facebook (mostly Instagram links)",
                        "index": 0
                      },
                      "@SITE_HOST@": {
                        "text": "Your own site",
                        "index": 1
                      },
                      "ig": {
                        "text": "Instagram (tag: ig, set by Instagram)",
                        "index": 2
                      },
                      "instagram": {
                        "text": "Instagram (tag: instagram)",
                        "index": 3
                      },
                      "bluesky": {
                        "text": "Bluesky (tag: bluesky)",
                        "index": 4
                      },
                      "threads": {
                        "text": "Threads (tag: threads)",
                        "index": 5
                      },
                      "tiktok": {
                        "text": "TikTok (tag: tiktok)",
                        "index": 6
                      },
                      "facebook": {
                        "text": "Facebook (tag: facebook)",
                        "index": 7
                      },
                      "x": {
                        "text": "X (tag: x)",
                        "index": 8
                      },
                      "discord": {
                        "text": "Discord (tag: discord)",
                        "index": 9
                      },
                      "youtube": {
                        "text": "YouTube (tag: youtube)",
                        "index": 10
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "empty",
                      "result": {
                        "text": "Direct / unknown"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
