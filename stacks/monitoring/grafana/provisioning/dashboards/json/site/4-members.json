    {
      "id": 10,
      "type": "timeseries",
      "title": "Newsletter open rate by send",
      "description": "Open rate of each newsletter (opens / delivered), for newsletters with open tracking on. Apple Mail Privacy Protection counts as opens, so it reads high.",
      "datasource": {
        "type": "mysql",
        "uid": "ghost-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS time, ROUND(100 * opened_count / NULLIF(delivered_count, 0), 1) AS open_rate\nFROM emails\nWHERE status = 'submitted' AND track_opens = 1 AND $__timeFilter(created_at)\nORDER BY time",
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "ghost-mysql"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 6,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
