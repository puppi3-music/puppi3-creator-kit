    {
      "id": 11,
      "type": "table",
      "title": "Newsletters",
      "description": "The last 25 newsletters, with delivery and open numbers. Unsubscribed (2 days) = newsletter unsubscribes in the 2 days after it went out (by anyone, so a guide, not proof it was this one). Spam complaints = people who marked it as spam.",
      "datasource": {
        "type": "mysql",
        "uid": "ghost-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.created_at AS Sent, e.subject AS Subject, e.email_count AS Recipients, e.delivered_count AS Delivered,\n       e.failed_count AS Failed, e.opened_count AS Opens,\n       ROUND(100 * e.opened_count / NULLIF(e.delivered_count, 0), 1) AS `Open %`,\n       (SELECT COUNT(*) FROM members_subscribe_events s WHERE s.subscribed = 0\n          AND s.created_at >= e.created_at AND s.created_at < e.created_at + INTERVAL 2 DAY) AS `Unsubscribed (2 days)`,\n       (SELECT COUNT(*) FROM email_spam_complaint_events c WHERE c.email_id = e.id) AS `Spam complaints`\nFROM emails e\nWHERE e.status = 'submitted'\nORDER BY e.created_at DESC\nLIMIT 25",
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "ghost-mysql"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Open %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Spam complaints"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "pluginVersion": "13.0.2",
      "links": [],
      "transformations": []
    },
    {
