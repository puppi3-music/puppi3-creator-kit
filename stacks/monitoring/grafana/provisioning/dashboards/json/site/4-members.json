    {
      "id": 7,
      "type": "timeseries",
      "title": "Members over time",
      "description": "Total members at the end of each day.",
      "datasource": {
        "type": "mysql",
        "uid": "ghost-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, members FROM (\n  SELECT CAST(d AS DATETIME) AS time, SUM(n) OVER (ORDER BY d) AS members\n  FROM (SELECT DATE(created_at) AS d, COUNT(*) AS n FROM members GROUP BY d) daily\n) t\nWHERE $__timeFilter(time)\nORDER BY time",
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "ghost-mysql"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter",
            "showPoints": "auto"
          },
