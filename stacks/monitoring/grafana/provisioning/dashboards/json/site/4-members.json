    {
      "id": 215,
      "type": "table",
      "title": "Delivery problems",
      "description": "Newsletter emails that failed in the selected range, newest first (Mailgun's reason). Permanent = the address doesn't work (Ghost stops emailing it); temporary = Mailgun gave up retrying (a full inbox, a server down).",
      "datasource": {
        "type": "mysql",
        "uid": "ghost-mysql"
      },
      "gridPos": {
        "x": 12,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "ghost-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT f.failed_at AS Failed, e.subject AS Newsletter, COALESCE(m.email, r.member_email) AS Member,\n       f.severity AS Kind, f.code AS Code, f.message AS Reason\nFROM email_recipient_failures f\nJOIN emails e ON e.id = f.email_id\nLEFT JOIN email_recipients r ON r.id = f.email_recipient_id\nLEFT JOIN members m ON m.id = f.member_id\nWHERE $__timeFilter(f.failed_at)\nORDER BY f.failed_at DESC\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "noValue": "No failed deliveries",
          "custom": {
            "cellOptions": {
              "type": "auto",
              "wrapText": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Reason"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "pluginVersion": "13.0.2",
