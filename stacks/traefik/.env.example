# Variables for the traefik stack's .env
# Cloudflare API token for the DNS challenge (TLS_RESOLVER=cf), with Zone > DNS > Edit on the site's zone
CLOUDFLARE_DNS_API_TOKEN=
# Let's Encrypt account email; keep it once certificates are issued, so Traefik keeps using the same account
ACME_EMAIL=

# Site values, from the instance profile (instances/CLAUDE.md): the stacks folder's global.env where each stack
# runs on its own (every stack reads it), the kit's site.env. DATA_DIR and SITE_HOST must be set
#DATA_DIR=/srv/stacks
#SITE_HOST=example.com
