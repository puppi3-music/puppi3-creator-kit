# Variables for the Ghost stack's .env
# Ghost's MySQL by container name [puppi3-db-1; a kit site's is set for it]; never "db", which other stacks on the
# proxy network also answer to. (database__connection__host is no longer read.)
#GHOST_DB_HOST=puppi3-db-1
# Ghost's MySQL login (the root user, which the stack's MySQL is made with) and Ghost's database
database__connection__user=root
database__connection__password=
database__connection__database=ghost-puppi3

# Site values, from the instance profile (instances/CLAUDE.md): the stacks folder's global.env where each stack
# runs on its own (every stack reads it), the kit's site.env. GHOST_DATA_DIR (this stack's data folder; kit.sh sets it)
# and SITE_HOST must be set
#GHOST_DATA_DIR=/srv/stacks/ghost
#SITE_HOST=example.com
