# Variables for the icecast stack's .env: none of TinyIce's own (it keeps its passwords, hashed,
# in tinyice-data/config.json; the ICECAST_* settings were the old Icecast's)

# Site values, from the instance profile (instances/CLAUDE.md): the stacks folder's global.env where each stack
# runs on its own (every stack reads it), the kit's site.env. DATA_DIR and SITE_HOST must be set; LIVE_HOST
# defaults to live.<SITE_HOST>
#DATA_DIR=/srv/stacks
#SITE_HOST=example.com
#LIVE_HOST=live.example.com
