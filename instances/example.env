# A site's instance profile: every site-level setting of Puppi3's Creator Kit, in one file.
# Copy it to instances/<your site>.env and fill it in. No secrets here (they stay in each stack's .env,
# or Kubernetes Secrets): this file is committed. instances/CLAUDE.md says what reads each setting.

# The site's own address (no https://), and its name as people see it (the weekly summary's title, Grafana's folder)
SITE_HOST=example.com
SITE_NAME=example.com
# The site's time zone (the dashboards' days, the weekly summary, When to post, the seasonal reminders)
SITE_TIMEZONE=Etc/UTC

# The live stream's address (no https://), with the live module
LIVE_HOST=live.example.com
# Grafana: the name it's served at, and the address the phone's notification buttons open
GRAFANA_HOST=grafana.example.com
GRAFANA_URL=https://grafana.example.com

# Short lowercase name used inside: container and Compose project names, Grafana uids, metric names, Prometheus jobs,
# Traefik router names, the alert rules' project label, and on Kubernetes the namespace. Change it and those all
# change (a kit site's Docker volumes too, with the analytics in them), so pick it once.
ID_PREFIX=site

# true = only Cloudflare reaches the site (cloudflare-only, real-ip use its addresses); false = open to all
BEHIND_CLOUDFLARE=true
# Addresses let in besides Cloudflare's (comma-separated ranges), e.g. your home network, or none
TRUSTED_EXTRA=none
# Traefik's certificates: cf = Let's Encrypt through Cloudflare's DNS, the one that works behind Cloudflare's proxy
# (CLOUDFLARE_DNS_API_TOKEN in Traefik's secrets: a kit site's secrets/traefik.env); le = Let's Encrypt over the TLS
# challenge (port 443 open to it, the DNS records not proxied); self = Traefik's own certificate; none = plain http.
# kit/setup.sh picks cf behind Cloudflare, le otherwise
TLS_RESOLVER=le
# Home-network-only names end in this (traefik.<it>, tinyice.<it>, grafana.<it>: Traefik's dashboard, TinyIce's admin,
# Grafana), answered from private addresses only (lan-only.yml among Traefik's dynamic files: a kit site's
# data/traefik/dynamic/)
LAN_DOMAIN=localhost

# Which optional parts run (comma-separated): analytics, social, live, monitoring, pets (pets: the route a theme with
# a pettable mascot sends its pets to, with PETS below for their panels; the kit's theme has none)
MODULES=analytics,social,live,monitoring
# Which networks get a section on the dashboards and a collector in the bridge (comma-separated):
# ghost, instagram, youtube, soundcloud, bluesky, threads, tiktok, mixcloud
NETWORKS=ghost,instagram,youtube,soundcloud,bluesky,threads,tiktok,mixcloud

# The site's other names (links to them count as the site's own pages, not clicks off it) and the live stream's
# (links there count as Live stream clicks), comma-separated; empty = SITE_HOST (and www.) and LIVE_HOST
SITE_HOSTS=
LIVE_HOSTS=
# The mascot's pets on the dashboards (a theme with a pettable mascot, and pets in MODULES): true or false
PETS=false

# ntfy server for phone notifications and alerts (e.g. https://ntfy.sh, with a private topic in the bridge's secrets);
# empty = none (a site tried out before it's public: its checks would fail and alert)
NTFY_URL=https://ntfy.sh
# The disk the site's data is on, as the host mounts it, for Health's "Disk free" tile and its alert (monitoring);
# empty = the root filesystem. On Docker Desktop (a Mac, Windows) kit/setup.sh sets /var/lib/docker: the root of its
# own Linux machine is a kind the disk check can't read
#DISK_MOUNT=/

# The host's ports, for a machine where one is taken already (a kit site only): the web ones (Let's Encrypt's le
# certificates need 443 itself) and the live stream's, which the streaming software sends to
#HTTP_PORT=80
#HTTPS_PORT=443
#LIVE_PORT=8222
# Who reaches the live stream's port. The streaming software sends there straight to the stream server, past Traefik,
# so the port also answers the stream server's admin sign-in, over plain http (the source password crosses unencrypted).
# Compose: LIVE_BIND is the one host address it listens on (empty = every address; 127.0.0.1 when the streaming software
# runs on this machine, a home or VPN address to stream only from there); a firewall rule keeping the port to your
# own addresses does the rest. Kubernetes: LIVE_SOURCE_RANGES, comma-separated ranges its load balancer lets in
# (empty = everyone)
#LIVE_BIND=
#LIVE_SOURCE_RANGES=
# http:// and www.<site> go to https://<site> (a kit site only; with certificates: TLS_RESOLVER cf, le or self)
#HTTPS_REDIRECT=true

# How posts are shared (the social module). Each line shows its default: take the # off to change one.

# The Postiz channel types a post goes to (Postiz's names for them)
#CHANNELS=bluesky,threads,instagram-standalone,tiktok,tiktok-business
# Only public posts are shared (members-only and paid posts are skipped)
#ONLY_PUBLIC=true

# Instagram and TikTok (Bluesky and Threads always post by themselves). manual = a Postiz draft and a phone
# notification for each, and you post it in the app; audio = post by itself when the post has sound, else manual;
# auto = always post by itself. TikTok: UPLOAD puts it in your TikTok inbox to finish, DIRECT_POST publishes it,
# with TIKTOK_PRIVACY (an app TikTok hasn't audited must use SELF_ONLY)
#IG_TIKTOK_MODE=manual
#TIKTOK_METHOD=UPLOAD
#TIKTOK_PRIVACY=SELF_ONLY
# Keep the manual ones as Postiz drafts too (never published), with this Postiz tag on them (make the tag once in
# Postiz; empty = no tag)
#MANUAL_DRAFTS=true
#DRAFT_TAG=Post in app

# Internal tags you add to a post in Ghost: skip it, a big release (a phone reminder to post your Story with a
# link sticker), post Instagram and TikTok by themselves or by hand for this post only, an Instagram Story instead
# of a feed post, use the Excerpt as the text, and #campaign-<name> (its links say which campaign)
#SKIP_TAG=#nosocial
#BIG_DROP_TAG=#bigdrop
#AUTOPOST_TAG=#autopost
#MANUALPOST_TAG=#manualpost
#STORY_TAG=#story
#EXCERPT_TAG=#useexcerpt
#CAMPAIGN_TAG=#campaign-
# With a big release, also post an Instagram Story by itself (one without the link)
#BIG_DROP_AUTO_STORY=false

# The text: body = what you write in the post (the Excerpt only when there's none), excerpt = the Excerpt; the
# post's title on top or not. Links to the site go out as short tagged links (/b/<post> for Bluesky...), so the
# dashboards know which network sent each visitor; false = plain links
#TEXT_SOURCE=body
#INCLUDE_TITLE=false
#TAG_LINKS=true
# The featured link: a link in the post to where the work itself is (a video, an episode, a track...) gets a line
# of its own in the social posts. It's a link to one of these services: one earlier in the list wins, then the
# first in the post (FEATURED_DOMAINS=none: no featured line).
# Its line where links can be tapped (Bluesky, Threads) and on Instagram and TikTok (where they can't): [name] is
# the service, [url] the link. The Social preview calls it FEATURED_LABEL, after the line's first emoji
#FEATURED_DOMAINS=youtube.com,youtu.be,vimeo.com,soundcloud.com,on.soundcloud.com,mixcloud.com,open.spotify.com,podcasts.apple.com,music.apple.com,bandcamp.com,twitch.tv
#FEATURED_LINE=🔗 [name]: [url]
#FEATURED_BIO_LINE=🔗 Also on [name] + the full post: link in bio
#FEATURED_LABEL=Featured link

# Pictures and sound: a video uploaded to the post instead of its feature image, the gallery's pictures too (at
# most MAX_IMAGES in all), and an audio card made into a video (cover art, a waveform and your sound). Long audio
# is cut to CLIP_SECONDS (90 at most) from CLIP_DEFAULT_START seconds in, unless the post has a tag like #clip 12:30
#SHARE_VIDEO=true
#GALLERY=true
#MAX_IMAGES=10
#AUDIOGRAM=true
#CLIP_SECONDS=30
#CLIP_DEFAULT_START=60

# Phone notifications: when sharing a post fails; Postiz's own (failed posts, a network to reconnect); and every
# post that went out
#NOTIFY_ERRORS=true
#POSTIZ_ALERTS=true
#POSTIZ_ALERTS_SUCCESS=false

# Where the stacks keep their data: the folder that holds each stack's folder. kit/kit.sh sets it to the site
# folder's data/, so a kit site leaves it unset; a server running the stacks on their own sets its own.
#DATA_DIR=
# ...and the Ghost stack's own folder in it (Ghost's content and config, MySQL, Tinybird's tokens). kit/kit.sh sets it to
# data/ghost/ (data/puppi3/ for a site made before kit 1.2.0); a server running the stacks on their own sets it.
#GHOST_DATA_DIR=
