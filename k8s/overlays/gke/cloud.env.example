# A site's values for the gke overlay: copy to <site>/cloud-gke.env and fill in (k8s/up.sh <site> gke reads it).
# Made once per site with the cloud's own tools (the Cloud guide's Google GKE, once, with every command): the Cloud SQL instances, the bucket and its HMAC
# key, and the Google service account the Cloud SQL proxies act as.

# Ghost's MySQL: Cloud SQL for MySQL 8's connection name (project:region:instance). Ghost signs in with
# secrets/ghost.env's login.
MYSQL_INSTANCE=example-project:us-central1:example-site-mysql
# Postiz's and Temporal's Postgres (social module; empty without it): Cloud SQL for Postgres's connection name. Its master login goes
# in secrets/cloud.env (POSTGRES_MASTER_USER=postgres, POSTGRES_MASTER_PASSWORD=...); the postgres-logins Job makes
# Postiz's and Temporal's from it. The proxy encrypts the connection, so the instance's own SSL setting can stay
# as it is.
POSTGRES_INSTANCE=example-project:us-central1:example-site-postgres
# The Google service account the proxies act as (Workload Identity, for Kubernetes service account "cloud-sql" in
# the site's namespace), with the Cloud SQL Client role
CLOUD_SQL_SA=example-site-sql@example-project.iam.gserviceaccount.com
# More flags for the proxies, if any: --private-ip when the instances have only a private address in the cluster's
# VPC (empty: their public address, which the proxy reaches with no authorized networks opened)
CLOUD_SQL_PROXY_FLAGS=
# Ghost's images, media and files: the bucket (private; Ghost serves them) through Cloud Storage's S3 API. Its HMAC
# key (a service account's, with Storage Object User on the bucket) goes in secrets/s3.env
# (AWS_ACCESS_KEY_ID=GOOG..., AWS_SECRET_ACCESS_KEY=...).
S3_BUCKET=example-site-content
S3_REGION=auto
S3_ENDPOINT=https://storage.googleapis.com
