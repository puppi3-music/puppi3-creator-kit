# A site's values for the eks overlay: copy to <site>/cloud-eks.env and fill in (k8s/up.sh <site> eks reads it).
# Made once per site with the cloud's own tools (the Cloud guide's Amazon EKS, once, with every command): the RDS instances in the cluster's VPC,
# reachable only from its nodes' security group, the bucket, and Ghost's IAM role.

# Ghost's MySQL: RDS for MySQL 8's endpoint. Ghost signs in with secrets/ghost.env's login.
MYSQL_HOST=ghost.abc123example.us-east-1.rds.amazonaws.com
# Postiz's and Temporal's Postgres (social module): RDS for Postgres's endpoint. Its master login goes in
# secrets/cloud.env (POSTGRES_MASTER_USER=..., POSTGRES_MASTER_PASSWORD=...); the postgres-logins Job makes Postiz's and
# Temporal's from it. RDS for Postgres 15+ asks for TLS by default (rds.force_ssl): Postiz and Temporal connect
# without it, so the instance's parameter group sets rds.force_ssl=0 (the traffic stays in the VPC).
POSTGRES_HOST=postiz.abc123example.us-east-1.rds.amazonaws.com
# Ghost's images, media and files: the bucket (private; Ghost serves them) and its region
S3_BUCKET=example-site-content
S3_REGION=us-east-1
# The IAM role Ghost's ServiceAccount takes (IRSA), allowed s3:GetObject, PutObject, DeleteObject on the bucket's
# objects and s3:ListBucket on the bucket
GHOST_ROLE_ARN=arn:aws:iam::123456789012:role/example-site-ghost
