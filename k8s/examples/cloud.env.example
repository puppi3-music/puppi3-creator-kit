# The cloud's Postgres master login: copy to <site>/secrets/cloud.env (eks and gke, with the social module; k8s/up.sh
# makes Secret "cloud"). The postgres-logins Job signs in with it to make Postiz's and Temporal's own logins and
# databases (their passwords: secrets/postiz.env). The k3d twins make a stand-in login themselves.

# RDS's master user (whatever it was made with), or Cloud SQL's built-in "postgres"
POSTGRES_MASTER_USER=postgres
POSTGRES_MASTER_PASSWORD=
