# Ghost's mail on Kubernetes: copy to <site>/secrets/ghost-mail.env (k8s/up.sh makes Secret "ghost-mail", which Ghost
# reads as its mail settings, https://ghost.org/docs/config/#mail). Without it Ghost uses Direct mail, which rarely
# arrives, so staff sign-in codes and members' sign-in links go missing. Any of Ghost's mail__* settings work.

# How Ghost sends: SMTP, through your mail provider
mail__transport=SMTP
# Who the mail is from: a name, then an address the provider lets you send as
mail__from=Example Site noreply@example.com
# The provider's SMTP server and port; secure=true for port 465, false with requireTLS=true for 587
mail__options__host=smtp.example.com
mail__options__port=587
mail__options__secure=false
mail__options__requireTLS=true
# The provider's SMTP login
mail__options__auth__user=
mail__options__auth__pass=
